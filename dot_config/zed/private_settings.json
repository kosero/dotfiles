// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "vim_mode": false,
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "language_models": {
    "llama.cpp": {
      "api_url": "http://127.0.0.1:8000"
    }
  },
  "disable_ai": true,
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "default_model": {
      "provider": "llama.cpp",
      "model": "qwen3.6-35b",
      "enable_thinking": true
    },
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "terminal": {
    "flexible": false,
    "dock": "bottom"
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "format_on_save": "on",
  "icon_theme": "Material Icon Theme",
  "mouse_wheel_zoom": true,
  "project_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Gruvbox Dark",
  },
}
